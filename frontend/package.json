{
  "name": "cloudpulse-monitor-frontend",
  "version": "0.1.0",
  "description": "Fast and simple uptime monitoring tool frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc --build --force && vite build",
    "build-only": "vite build",
    "dev": "vite",
    "lint": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
    "format": "prettier --write src/",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force"
  },
  "dependencies": {
    "chart.js": "^4.3.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.31",
    "vue-chartjs": "^5.2.0",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/node18": "^18.2.0",
    "@types/node": "^20.4.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^9.15.1",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.1.6",
    "vite": "^8.0.3",
    "vue-tsc": "^1.8.8"
  }
}
