# CloudPulse Monitor Environment Configuration
# Copy this file to .env and update with your settings

# ========================================
# Database Configuration
# ========================================
# Database type: postgresql, mysql, or sqlite
# Default: postgresql
DB_TYPE=postgresql

# PostgreSQL Configuration (when DB_TYPE=postgresql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudpulse
DB_USER=postgres
DB_PASS=postgres

# MySQL Configuration (when DB_TYPE=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=cloudpulse
# DB_USER=root
# DB_PASS=root

# SQLite Configuration (when DB_TYPE=sqlite)
# DB_PATH=./data/cloudpulse.db

# ========================================
# Backend Configuration (Spring Boot)
# ========================================
# Server port (default: 8080)
SERVER_PORT=8080

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ========================================
# Frontend Configuration (Vue/Vite)
# ========================================
# API URL for production builds (optional in dev - uses proxy)
# VITE_API_URL=http://localhost:8080

# ========================================
# Optional: Email Notifications (Future)
# ========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ========================================
# Optional: Logging
# ========================================
# LOG_LEVEL=info
